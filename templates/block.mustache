{{!
    @template block_studiosity/block

    Template which defines a Studiosity block

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * courseid - int: Id of learninghub course the block links to (deprecated).

    Tab tree.

    Example context (json):
    {
        "courseid": 51232,
        "coursemoduleid": 7657,
        "imagepath": "https://www.moodle.com/image"
    }


}}
<div class="block_studiosity-maincontent">
   <a href="{{#coursemoduleid}}/mod/lti/view.php?id={{coursemoduleid}}{{/coursemoduleid}}{{^coursemoduleid}}#{{/coursemoduleid}}" target="_blank" title="Go to my account">
       <img class="img-fluid align-top" src="/blocks/studiosity/pix/latrobe-studiosity.png" alt="Studiosity">    
    </a>
</div>
